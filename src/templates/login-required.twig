{% extends '_layouts/message' %}

{% set title = 'cart.login.title'|t('klaviyoconnect') %}

{% block message %}
  <h2 class="first">{{ title }}</h2>
  <p>{{ message }}</p>

  {% if logOutFirst %}
    <form method="post" accept-charset="UTF-8">
      {{ csrfInput() }}
      {{ hiddenInput('logOut', '1') }}
      <div class="buttons">
        <button type="submit" class="btn submit">{{ 'cart.login.logOutButton'|t('klaviyoconnect') }}</button>
      </div>
    </form>
  {% else %}
    <div class="buttons">
      <a class="btn submit" href="{{ loginUrl }}">{{ 'cart.login.button'|t('klaviyoconnect') }}</a>
    </div>
  {% endif %}
{% endblock %}
